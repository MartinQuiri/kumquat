<Project>
  <!-- Configuración común a todos los proyectos. Cambiar aquí, no en cada .csproj. -->
  <PropertyGroup>
    <!-- La interfaz (rueda, ventanas, bandeja, menú del Explorador) es solo de Windows; el núcleo, los
         motores y la CLI corren también en Linux y macOS. Un proyecto nuevo que use Win32, COM o WPF
         va en esta lista. -->
    <KumquatWindowsOnly Condition="'$(MSBuildProjectName)' == 'Kumquat.App' Or '$(MSBuildProjectName)' == 'Kumquat.Interaction' Or '$(MSBuildProjectName)' == 'Kumquat.Dialogs' Or '$(MSBuildProjectName)' == 'Kumquat.Design' Or '$(MSBuildProjectName)' == 'Kumquat.ShellExtension' Or '$(MSBuildProjectName)' == 'Kumquat.Interaction.Tests' Or '$(MSBuildProjectName)' == 'Kumquat.ShellExtension.Tests' Or '$(MSBuildProjectName)' == 'Kumquat.E2E.Tests'">true</KumquatWindowsOnly>
    <!-- Sin versión de SDK de Windows: no usamos WinRT y la proyección CsWinRT pesa ~53 MB. -->
    <TargetFramework Condition="'$(KumquatWindowsOnly)' == 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(KumquatWindowsOnly)' != 'true'">net10.0</TargetFramework>
    <!-- Permite restaurar y compilar los proyectos de Windows desde Linux o macOS (p. ej. dotnet format);
         ejecutarlos sigue requiriendo Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers Condition="'$(KumquatWindowsOnly)' == 'true'">win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(KumquatWindowsOnly)' != 'true'">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <!-- Una sola carpeta de salida (bin/<config>/<tfm>) para cualquier plataforma: evita binarios
         desactualizados al mezclar compilaciones por solución y por proyecto. -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <!-- Sin plataforma explícita se compila x64 (si no, la solución elige ARM64 por orden alfabético
         y un binario ARM64 pisa al x64 en la carpeta compartida). La CI pasa -p:Platform=ARM64. -->
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>

    <!-- Calidad: toda advertencia es un error. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: comentarios XML en miembros públicos se exigen solo en Core/Abstractions (ver sus .csproj). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Builds deterministas y auditoría de dependencias. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <Company>Kumquat contributors</Company>
    <Product>Kumquat</Product>
    <Copyright>Copyright (C) 2026 Kumquat contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.2.0</Version>
  </PropertyGroup>

  <!-- Proyectos de test: xUnit v3 sobre Microsoft.Testing.Platform (global.json lo pide para
       `dotnet test`); sin esto el ejecutable usa el runner propio de xUnit y rechaza las opciones
       de cobertura, filtros por rasgo y códigos de salida que usa la CI. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
</Project>
