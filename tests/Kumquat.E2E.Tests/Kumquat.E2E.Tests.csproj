<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!-- CI pasa la opción de cobertura a todos los proyectos de test: sin esto, este rechaza el argumento (código 5). -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <!-- Se copia Kumquat.exe junto a los tests para lanzarlo como proceso real. -->
    <ProjectReference Include="..\..\src\Kumquat.App\Kumquat.App.csproj" />
    <ProjectReference Include="..\..\src\Kumquat.Core\Kumquat.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
