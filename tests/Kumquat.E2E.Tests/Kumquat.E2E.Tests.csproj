<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <!-- Se compila la app para lanzarla como proceso real; no se referencia su ensamblado. -->
    <ProjectReference Include="..\..\src\Kumquat.App\Kumquat.App.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Kumquat.Core\Kumquat.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
