<Project Sdk="Microsoft.NET.Sdk">
  <!-- Identidad visual compartida por la rueda (GDI+) y las ventanas (WPF): íconos, tipografía,
       paleta y logo. Sin dependencias de UI, para poder probarla sola. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
    <!-- IL puro: sin esto, compilar la solución sin plataforma (elige ARM64) lo marcaba ARM64 y un
         proceso x64 no podía cargarlo. Lo vigila ArquitecturaTests. -->
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kumquat.Core\Kumquat.Core.csproj" />
    <InternalsVisibleTo Include="Kumquat.Interaction.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Recursos junto al ejecutable (los proyectos que referencian a este los heredan). -->
    <None Include="..\..\assets\fonts\*.ttf;..\..\assets\fonts\Inter-LICENSE.txt" Link="assets\fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\logo\kumquat.png;..\..\assets\logo\kumquat.ico" Link="assets\logo\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\assets\Phosphor-LICENSE.txt" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
