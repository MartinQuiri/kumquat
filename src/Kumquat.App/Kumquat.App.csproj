<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kumquat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo\kumquat.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Arranque rápido del ícono de bandeja: código precompilado. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF solo para la ventana de opciones (tema Fluent). WPF no admite trimming, así que la app
         se publica sin recortar; WPF se carga recién al abrir una ventana, no al arrancar. -->
    <UseWPF>true</UseWPF>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kumquat.Hosting\Kumquat.Hosting.csproj" />
    <ProjectReference Include="..\Kumquat.Interaction\Kumquat.Interaction.csproj" />
    <ProjectReference Include="..\Kumquat.Dialogs\Kumquat.Dialogs.csproj" />
    <InternalsVisibleTo Include="Kumquat.Interaction.Tests" />
    <!-- UseWPF quita System.IO de los usings implícitos (choca con System.Windows.Shapes.Path); aquí no se usan formas. -->
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <!-- Motores descargados por tools/fetch-engines.ps1: se copian junto al ejecutable. -->
    <!-- Solo lo necesario en runtime (sin include/, lib/, doc/ ni ffplay). -->
    <None Include="..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\*.dll;..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\ffmpeg.exe;..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\ffprobe.exe" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\ffmpeg\bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\ffmpeg\$(RuntimeIdentifier)\LICENSE.txt;..\..\engines\ffmpeg\$(RuntimeIdentifier)\SOURCE.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- qpdf: ejecutable + sus DLL (incluye el runtime de MSVC). -->
    <None Include="..\..\engines\qpdf\$(RuntimeIdentifier)\bin\*.dll;..\..\engines\qpdf\$(RuntimeIdentifier)\bin\qpdf.exe" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\qpdf\bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\qpdf\$(RuntimeIdentifier)\SOURCE.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\qpdf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Tesseract (compilado por tools/build-tesseract.ps1): ejecutable, modelos de idioma y licencias. -->
    <None Include="..\..\engines\tesseract\$(RuntimeIdentifier)\bin\tesseract.exe" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\tesseract\bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\tesseract\$(RuntimeIdentifier)\tessdata\spa.traineddata;..\..\engines\tesseract\$(RuntimeIdentifier)\tessdata\eng.traineddata" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\tesseract\tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\tesseract\$(RuntimeIdentifier)\tessdata\configs\pdf;..\..\engines\tesseract\$(RuntimeIdentifier)\tessdata\configs\txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\tesseract\tessdata\configs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\tesseract\$(RuntimeIdentifier)\licenses\*.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\tesseract\licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\tesseract\$(RuntimeIdentifier)\SOURCE.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\tesseract\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- MuPDF: solo mutool (sin los visores mupdf.exe / mupdf-gl.exe). -->
    <None Include="..\..\engines\mupdf\$(RuntimeIdentifier)\mutool.exe;..\..\engines\mupdf\$(RuntimeIdentifier)\COPYING.txt;..\..\engines\mupdf\$(RuntimeIdentifier)\SOURCE.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\mupdf\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
