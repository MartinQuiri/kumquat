<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kumquat</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Arranque rápido del ícono de bandeja: código precompilado. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Trimming verificado: 0 advertencias IL; arranque ~275 ms y ~40 MB en reposo. -->
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kumquat.Hosting\Kumquat.Hosting.csproj" />
    <ProjectReference Include="..\Kumquat.Interaction\Kumquat.Interaction.csproj" />
    <InternalsVisibleTo Include="Kumquat.Interaction.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Motores descargados por tools/fetch-engines.ps1: se copian junto al ejecutable. -->
    <!-- Solo lo necesario en runtime (sin include/, lib/, doc/ ni ffplay). -->
    <None Include="..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\*.dll;..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\ffmpeg.exe;..\..\engines\ffmpeg\$(RuntimeIdentifier)\bin\ffprobe.exe" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\ffmpeg\bin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\engines\ffmpeg\$(RuntimeIdentifier)\LICENSE.txt;..\..\engines\ffmpeg\$(RuntimeIdentifier)\SOURCE.txt" Condition="'$(RuntimeIdentifier)' != ''" Link="engines\ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
