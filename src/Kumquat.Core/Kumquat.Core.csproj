<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- El dominio no depende de Windows: así sus tests corren en cualquier runner. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- En el núcleo toda API pública debe estar documentada. -->
    <NoWarn>$(NoWarn.Replace('CS1591', ''))</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <InternalsVisibleTo Include="Kumquat.Core.Tests" />
  </ItemGroup>
</Project>
