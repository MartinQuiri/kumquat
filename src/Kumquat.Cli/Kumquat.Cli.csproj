<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- No puede llamarse "kumquat": en Windows chocaría con Kumquat.exe (la app) en la misma carpeta. -->
    <AssemblyName>kumquat-cli</AssemblyName>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kumquat.Hosting\Kumquat.Hosting.csproj" />
    <InternalsVisibleTo Include="Kumquat.Cli.Tests" />
  </ItemGroup>
</Project>
